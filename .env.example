PHASE1_DB_PATH=project/data/phase1.sqlite3
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_HISTORY_BASE_URL=https://history.deribit.com/api/v2
DERIBIT_TIMEOUT_S=20
DERIBIT_PAGE_SIZE=1000
DERIBIT_HISTORY_PAGE_SIZE=10000
DERIBIT_USE_HISTORY_FOR_BACKFILL=true
PHASE1_MAX_RETRIES=4
PHASE1_RETRY_BACKOFF_S=1.5
PHASE1_CHUNK_SIZE_MS=3600000
PHASE1_RESUME_ENABLED=true
PHASE1_VALIDATION_WINDOWS_MS=300000,3600000

GEX_SNAPSHOT_PATH=project/greeks/data/latest_gex_snapshot.json
# gex_window_history.json location (heatmap surface source of truth)
GEX_ARTIFACTS_DIR=project/runtime/dashboard_build
GEX_APP_NAME=Deribit BTC GEX Terminal
GEX_REFRESH_SECONDS=30
GEX_CONTRACT_VERSION=phase5.dashboard.v1
GEX_DEFAULT_EXPIRY=ALL
GEX_DEFAULT_VIEW=net
GEX_FRESHNESS_MULTIPLIER=12

# Options Surface validation corpus (no credentials).
# Collection is disabled unless explicitly enabled.
LOTUS_SURFACE_SERVING_MODE=diagnostic_candidate
# diagnostic_candidate | shadow_compare | disabled
LOTUS_SURFACE_PUBLISH_POLICY=serve
# serve | record_only  (record_only only affects shadow_compare)
LOTUS_SURFACE_DISABLED_BASELINE=rejected
LOTUS_SURFACE_CAPTURE_DIR=project/runtime/options_surface_snapshots
LOTUS_SURFACE_CAPTURE_RETENTION_DAYS=180
LOTUS_SURFACE_COLLECT_ENABLED=false
LOTUS_SURFACE_COLLECT_INTERVAL_SECONDS=3600
LOTUS_SURFACE_MAX_CURATED_EXPIRIES=4
